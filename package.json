{
  "name": "salotto-tv",
  "productName": "Salotto",
  "version": "0.1.28",
  "private": true,
  "description": "Trasforma il PC Windows in una TV: launcher a schermo intero, telecomando dal telefono, ricevitore DLNA",
  "main": "electron/main.cjs",
  "author": "Francesco Argento",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "finestra": "electron . --finestra",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64 --x64"
  },
  "build": {
    "appId": "it.salotto.tv",
    "productName": "Salotto",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "renderer/**",
      "remote/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "uninstallDisplayName": "${productName}",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "afterPack": "build/afterPack.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Salotto mostra e gestisce i dispositivi Bluetooth nelle sue Impostazioni.",
        "NSLocalNetworkUsageDescription": "Salotto riceve i comandi del telefono e i video DLNA sulla rete di casa.",
        "NSAppleEventsUsageDescription": "Salotto usa Eventi di Sistema per spegnere o riavviare il Mac quando lo chiedi.",
        "LSApplicationCategoryType": "public.app-category.entertainment"
      }
    },
    "dmg": {
      "title": "Salotto ${version}",
      "artifactName": "Salotto-${version}-mac-${arch}.${ext}"
    },
    "electronVersion": "45.2.1+wvcus",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    }
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "git+https://github.com/castlabs/electron-releases.git#v45.2.1+wvcus",
    "electron-builder": "26.18.0",
    "resedit": "^3.1.0"
  }
}
